# DaybyDay environment — copy to .env and fill in. NEVER commit real secrets.
# (Audit R2: the legacy system stored Twilio creds in a Sheet tab — do not do that here.)

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only; never ship to the app

# --- Twilio (SMS leg) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15555555555

# --- API ---
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080   # used to reconstruct the signed URL for Twilio validation
NODE_ENV=development

# --- Feature flags ---
TWILIO_VALIDATE=true   # set false only as an ops kill-switch
